MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/?appName=docmind-cluster-db
EMBEDDER_URL=https://docmind-embedder.vercel.app
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_CHAT_MODEL=mistral-small-latest
FRONTEND_ORIGIN=https://docmind-psi-liart.vercel.app
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=docmind
# Local only. Do NOT set PORT in Vercel — the platform injects it.
PORT=3001

# Vercel (docmind-be) Project Settings → Environment Variables:
#   MONGO_URI, EMBEDDER_URL, MISTRAL_API_KEY, FRONTEND_ORIGIN,
#   CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
# Do not add PORT. Atlas Network Access must allow 0.0.0.0/0 (or Vercel IPs).
